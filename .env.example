# band-bridge 环境变量示例
# 复制为 .env 并填入自己的值：cp .env.example .env

# 生成token：python3 -c "import secrets; print(secrets.token_hex(24))"
BAND_MCP_TOKEN=替换成你的token
BAND_MCP_PORT=8898
BAND_RECEIVER_PORT=8899
# BAND_DATA_DIR=可选，默认使用项目内 data/ 目录
# AI主动敲门：你的ntfy主题（ntfy.sh上自建，手机App订阅同一主题）
BAND_KNOCK_TOPIC=替换成你的ntfy主题
BAND_KNOCK_SERVER=https://ntfy.sh
